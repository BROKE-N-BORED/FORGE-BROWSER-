#!/bin/sh
# Forge Browser — double-click installer (no terminal).
#
# Double-click "Install Forge Browser" in the file manager. It
# installs the program under ~/.local/share/forge-browser-app,
# adds Forge Browser to the app menu with its icon, and offers
# to open it. Everything lives under $HOME — no sudo, no admin.
#
# What it needs from the internet (one time): the browser engine
# (Lightpanda + Chromium, ~330 MB) and the Qt window kit (~600 MB).
# After the first install, re-running it just updates the program.
# Your data (vault, memory, history) lives in ~/.forge and is
# never touched by an install or an update.
#
# Dialogs use zenity when installed (Linux Mint has it by default),
# else a small Tkinter helper (install-gui.py), else desktop
# notifications while the install runs quietly.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP_DIR="$HOME/.local/share/forge-browser-app"
APP_TMP="$APP_DIR.new"
APP_OLD="$APP_DIR.old"
DESKTOP_DIR="$HOME/.local/share/applications"
ICON_DIR="$HOME/.local/share/icons"
LOG="$APP_DIR/install.log"
DONE="$APP_DIR.install-done"

TITLE="Forge Browser installer"

# --- dialogs ---------------------------------------------------------
# GUI_MODE is zenity, tkinter, or notify.
if command -v zenity >/dev/null 2>&1; then
    GUI_MODE=zenity
elif python3 -c "import tkinter" 2>/dev/null; then
    GUI_MODE=tkinter
else
    GUI_MODE=notify
fi

gui_confirm() { # $1 = text — returns 0 on yes
    case "$GUI_MODE" in
        zenity) zenity --question --title="$TITLE" --text="$1" --no-wrap ;;
        tkinter) python3 "$DIR/install-gui.py" question "$TITLE" "$1" ;;
        *) return 0 ;;  # no GUI: double-clicking was the confirmation
    esac
}

gui_info() { # $1 = text
    case "$GUI_MODE" in
        zenity) zenity --info --title="$TITLE" --text="$1" --no-wrap ;;
        tkinter) python3 "$DIR/install-gui.py" info "$TITLE" "$1" ;;
        *) command -v notify-send >/dev/null 2>&1 && notify-send "$TITLE" "$1" ;;
    esac
}

gui_error() { # $1 = text
    case "$GUI_MODE" in
        zenity) zenity --error --title="$TITLE" --text="$1" --no-wrap ;;
        tkinter) python3 "$DIR/install-gui.py" error "$TITLE" "$1" ;;
        *) command -v notify-send >/dev/null 2>&1 && notify-send -u critical "$TITLE" "$1" ;;
    esac
}

gui_progress() { # shows progress until $DONE appears
    case "$GUI_MODE" in
        zenity)
            (
                while [ ! -f "$DONE" ]; do
                    LAST=$(tail -n 1 "$LOG" 2>/dev/null | tr -d '\r' | cut -c1-120)
                    echo "# ${LAST:-Working...}"
                    sleep 2
                done
            ) | zenity --progress --pulsate --auto-close \
                --title="$TITLE" \
                --text="Installing Forge Browser — the first install downloads the browser engine, so it takes a few minutes."
            ;;
        tkinter)
            python3 "$DIR/install-gui.py" progress "$TITLE" \
                "Installing Forge Browser — the first install downloads the browser engine, so it takes a few minutes." \
                "$LOG" "$DONE" "$INSTALL_PID"
            ;;
        *)
            command -v notify-send >/dev/null 2>&1 && notify-send "$TITLE" "Installing Forge Browser — this takes a few minutes the first time."
            while [ ! -f "$DONE" ]; do sleep 5; done
            ;;
    esac
}

fail() { # $1 = plain-words reason
    gui_error "$1

Details are in the install log:
$LOG"
    rm -f "$DONE" "$DONE.tmp"
    exit 1
}

kill_install_group() { # stop the background install, whole group
    # D21: Cancel kills install.sh plus its curl/pip children,
    # not just the shell — the install runs in its own process
    # group (setsid below), so a negative pid reaches all of them.
    # TERM first, KILL after a grace period; the plain-pid kill is
    # the fallback if the group form is not supported.
    if [ -n "$INSTALL_PID" ] && kill -0 "$INSTALL_PID" 2>/dev/null; then
        kill -TERM -- "-$INSTALL_PID" 2>/dev/null || kill -TERM "$INSTALL_PID" 2>/dev/null
        sleep 2
        if kill -0 "$INSTALL_PID" 2>/dev/null; then
            kill -KILL -- "-$INSTALL_PID" 2>/dev/null || kill -KILL "$INSTALL_PID" 2>/dev/null
        fi
        wait "$INSTALL_PID" 2>/dev/null
    fi
}

# --- pre-flight ------------------------------------------------------
if ! command -v python3 >/dev/null 2>&1; then
    fail "Python 3 is not installed, so Forge Browser cannot install. (Linux Mint normally has it — this machine may need its system Python restored.)"
fi
if [ ! -f "$DIR/run.sh" ] || [ ! -f "$DIR/install.sh" ]; then
    fail "The install files are missing from this folder — the download may be incomplete. Download the release zip again and try once more."
fi

if ! gui_confirm "Install Forge Browser?

It installs under your home folder, adds Forge Browser to the app menu with its icon, and never needs the terminal. The first install downloads the browser engine (about 1 GB, one time), so it takes a few minutes."; then
    exit 0
fi

# --- copy the program in ---------------------------------------------
# Safe swap: the new tree is built in .new first, then the old
# install is moved aside (not deleted), the new one moved in, and
# only then is the old one removed. If the move-in fails, the old
# install is restored — a failed swap leaves a working install.
rm -rf "$APP_TMP" "$APP_OLD"
mkdir -p "$APP_TMP" || fail "Could not create the install folder."
# D11: a .venv in the source tree is broken at its new path
# (absolute paths in pyvenv.cfg and shebangs), and __pycache__
# is stale bytecode — neither is copied. tar excludes them
# during the copy (a 600 MB venv is not copied just to be
# deleted); without tar, copy everything and prune them after.
if command -v tar >/dev/null 2>&1; then
    _COPY_TAR="$APP_DIR.copy.tar"
    if ( cd "$DIR" && tar --exclude='.venv' --exclude='__pycache__' -cf "$_COPY_TAR" . ) \
        && ( cd "$APP_TMP" && tar -xf "$_COPY_TAR" ); then
        rm -f "$_COPY_TAR"
    else
        rm -f "$_COPY_TAR"
        fail "Could not copy the program files."
    fi
else
    cp -R "$DIR"/. "$APP_TMP"/ || fail "Could not copy the program files."
    rm -rf "$APP_TMP/.venv"
    find "$APP_TMP" -name __pycache__ -type d -prune -exec rm -rf {} +
fi
if [ -e "$APP_DIR" ]; then
    mv "$APP_DIR" "$APP_OLD" || fail "Could not move the old install aside."
fi
if ! mv "$APP_TMP" "$APP_DIR"; then
    if [ -e "$APP_OLD" ] && mv "$APP_OLD" "$APP_DIR"; then
        fail "Could not move the program into place — the old install was restored."
    fi
    fail "Could not move the program into place."
fi
# D12: an update used to rebuild the venv from scratch (~600 MB
# of PySide6 over the wire) because the venv lived inside the
# swapped tree. Carry the old venv across when it still imports
# — it returns to the exact path it was built for, so its
# absolute paths are right again, and the new tree's install.sh
# then skips the rebuild. A venv that no longer imports is left
# behind and rebuilt.
if [ -x "$APP_OLD/.venv/bin/python" ] && [ ! -e "$APP_DIR/.venv" ]; then
    if "$APP_OLD/.venv/bin/python" -c "import PySide6.QtWebEngineWidgets" 2>/dev/null; then
        cp -R "$APP_OLD/.venv" "$APP_DIR/.venv"
    fi
fi
rm -rf "$APP_OLD"
rm -f "$DONE" "$DONE.tmp"

# --- run the engine + window install, with progress ------------------
# install.sh runs inside a background subshell that records its own
# exit status in $DONE; the progress dialog watches for that file.
# The whole install is capped at one hour — a stall past that means
# something is broken, and the log says what.
# D21: the install runs in its own process group (setsid, when
# available) so Cancel — and the timeout — kill the whole install
# (install.sh plus its curl/pip children) instead of orphaning
# them. The group id is the background job's pid.
if command -v setsid >/dev/null 2>&1; then _SETSID="setsid"; else _SETSID=""; fi
: > "$LOG"
# install.sh runs from inside the installed tree (its .venv and
# relative paths live there), and always records its exit status
# in $DONE — even if the cd itself fails — so the progress
# dialog never waits on a file that will never appear.
if command -v timeout >/dev/null 2>&1; then
    $_SETSID sh -c 'cd "$1" && timeout 3600 sh install.sh >"$2" 2>&1; echo $? > "$3.tmp"; mv "$3.tmp" "$3"' _ "$APP_DIR" "$LOG" "$DONE" &
else
    $_SETSID sh -c 'cd "$1" && sh install.sh >"$2" 2>&1; echo $? > "$3.tmp"; mv "$3.tmp" "$3"' _ "$APP_DIR" "$LOG" "$DONE" &
fi
INSTALL_PID=$!
gui_progress
if [ "$?" != "0" ]; then
    # Cancelled: stop the background install, then say so plainly.
    kill_install_group
    fail "The install was cancelled. Nothing was changed — run the installer again any time."
fi
STATUS=$(cat "$DONE" 2>/dev/null || echo 1)
rm -f "$DONE" "$DONE.tmp"
if [ "$STATUS" = "124" ]; then
    # D22: timeout(1) exits 124 when it kills the install at the
    # 1-hour cap — name the limit, and say re-running resumes.
    fail "The install ran past its 1-hour limit and was stopped. Run the installer again — it picks up where it left off (downloads resume, finished steps are skipped)."
elif [ "$STATUS" != "0" ]; then
    fail "The install did not finish cleanly. Check the log, then run the installer again — it picks up where it left off."
fi

# --- the window part must actually work --------------------------------
if ! "$APP_DIR/.venv/bin/python" -c "import PySide6.QtWebEngineWidgets" 2>/dev/null; then
    fail "Forge Browser installed, but the window part did not — it needs the internet for a one-time download. Check the connection and run the installer again."
fi

# --- menu entry + icon --------------------------------------------------
mkdir -p "$DESKTOP_DIR" "$ICON_DIR"
ICON_MISSING=0
if [ -f "$DIR/forge-browser.svg" ]; then
    cp "$DIR/forge-browser.svg" "$ICON_DIR/forge-browser.svg"
else
    # D23: a release without the icon ships a generic menu icon
    # — say so instead of leaving the person wondering.
    ICON_MISSING=1
fi
cat > "$DESKTOP_DIR/forge-browser.desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Forge Browser
Comment=Your browser. No accounts, no API keys. Nothing leaves this machine.
Exec=sh $APP_DIR/run.sh %u
Path=$APP_DIR
Icon=$ICON_DIR/forge-browser.svg
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=Forge Browser
EOF
chmod +x "$DESKTOP_DIR/forge-browser.desktop"
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
fi
if [ "$ICON_MISSING" = "1" ]; then
    gui_info "Forge Browser is installed, but the icon file was missing from the release, so the menu entry shows a generic icon. The program itself installed fine."
fi

# --- done ----------------------------------------------------------------
if gui_confirm "Forge Browser is installed — find it in your app menu.

Open it now?"; then
    ( nohup sh "$APP_DIR/run.sh" >/dev/null 2>&1 & )
fi
exit 0
